VITE_SUPABASE_URL=https://url.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=key

# URL a la que Supabase redirige tras confirmar correo o restablecer contraseña.
# Para la APK (Capacitor), usar: kodigo://restablecer (deep link).
# Para la web o dev local: http://localhost:5173 (o tu dominio publicado).
VITE_SUPABASE_REDIRECT_URL=kodigo://restablecer
